---
import {ClientRouter} from 'astro:transitions';
import {cn, withBase} from "../lib/utils";
import '@/styles/globals.css'

import Footer from "../components/Footer.astro";

import {SITE} from '@/config';

interface Props {
    title?: string;
    scrollSmooth: boolean;
    description?: string;
    tags?: string[];
    author?: string;
    imageOg?: string;
    canonicalURL?: string;
    fullWidth?: boolean;
}

const {
    title = SITE.title,
    description = SITE.description,
    tags = SITE.tags,
    author = SITE.author,
    scrollSmooth,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    imageOg = SITE.ogImage,
    fullWidth = false,
} = Astro.props;

const ogImageUrl = imageOg.startsWith('/')
    ? new URL(withBase(imageOg), Astro.site).href
    : imageOg;
---

<!doctype html>
<html lang={SITE.lang ?? "es"} class={cn({"scroll-smooth": scrollSmooth})}>
<head>
    <meta name="msapplication-TileColor" content="#000000"/>
    <meta name="viewport" content="width=device-width"/>
    <meta charset="UTF-8"/>
    <meta name="generator" content={Astro.generator}/>

    <meta name="title" content={title}/>
    <meta name="description" content={description}/>
    <meta name="keywords" content={tags.join(', ')}/>
    <meta name="author" content={author}/>
    <link rel="sitemap" href={withBase('/sitemap-index.xml')}/>
    <link rel="icon" href={withBase(SITE.favicon)}/>
    <link rel="canonical" href={canonicalURL}/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalURL}/>
    <meta property="og:image" content={ogImageUrl}/>
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image"/>
    <meta property="twitter:url" content={canonicalURL}/>
    <meta property="twitter:title" content={title}/>
    <meta property="twitter:description" content={description}/>
    <meta property="twitter:image" content={ogImageUrl}/>

    <title>{title}</title>
    <ClientRouter/>
</head>
<body class="mesh-bg antialiased text-on-surface w-full min-h-screen flex flex-col">
<main class={cn("data-grid-overlay", fullWidth ? "w-full" : "container py-24 flex gap-8 flex-col")} role="main"  id="top">
    <slot/>
</main>
<Footer/>
</body>
</html>
