---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ME } from '@/config';
import { withBase } from '@/lib/utils';

interface Hero {
    eyebrow: string;
    status: string;
    headline: string;
    summary: string;
    ctaLabel: string;
    secondaryCtaLabel: string;
}

interface Props {
    hero: Hero;
}

const { hero } = Astro.props;
const resume = withBase('/resume/?download=1');
const imagePath = `/src/assets/${ME.profileImage}`;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}');

if (!images[imagePath]) {
    throw new Error(`"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`);
}

const imageImport = await images[imagePath]();
const highlightPhrase = 'decisiones de negocio';
const [firstHeadlinePart, ...restHeadlineParts] = hero.headline.split(highlightPhrase);
const highlightedHeadline = restHeadlineParts.length > 0 ? highlightPhrase : '';
---

<section class="relative mx-auto max-w-container-max px-gutter pb-20 pt-16 md:pt-24" id="presentacion">
    <div class="absolute right-10 top-10 -z-10 h-64 w-64 rounded-full bg-primary-fixed/20 blur-3xl"></div>
    <div class="absolute bottom-10 left-10 -z-10 h-72 w-72 rounded-full bg-secondary-fixed/20 blur-3xl"></div>

    <div class="flex flex-col items-center gap-16 md:flex-row">
        <div class="relative z-10 flex-1 text-center md:text-left">
            <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-outline-variant/30 bg-surface-container-high px-4 py-2 shadow-sm">
                <span class="h-2 w-2 animate-pulse rounded-full bg-primary"></span>
                <span class="font-label-sm text-label-sm font-medium text-on-surface-variant">{hero.status}</span>
            </div>

            <h1 class="mb-4 font-headline-xl text-headline-xl-mobile leading-tight tracking-tight text-on-surface md:text-headline-xl">
                {firstHeadlinePart}
                {highlightedHeadline && (
                    <>
                        <br />
                        <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                            {highlightedHeadline}
                        </span>
                    </>
                )}
            </h1>

            <p class="mb-8 font-label-md text-label-md font-bold uppercase tracking-[0.2em] text-primary">
                {hero.eyebrow}
            </p>

            <p class="mx-auto mb-10 max-w-xl font-body-lg text-lg leading-relaxed text-on-surface-variant md:mx-0">
                {hero.summary}
            </p>

            <div class="flex flex-col justify-center gap-3 sm:flex-row md:justify-start">
                <a class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3 font-label-md text-label-md text-on-primary transition hover:bg-primary-container" href={resume} target="_blank" rel="noopener noreferrer">
                    {hero.ctaLabel}
                    <span class="material-symbols-outlined text-base">download</span>
                </a>
                <a class="inline-flex items-center justify-center gap-2 rounded-lg border border-outline-variant/40 bg-surface-container-low px-6 py-3 font-label-md text-label-md text-on-surface transition hover:bg-surface-container-high" href={ME.contactInfo.linkedin} target="_blank" rel="noopener noreferrer">
                    {hero.secondaryCtaLabel}
                    <span class="material-symbols-outlined text-base">arrow_forward</span>
                </a>
            </div>
        </div>

        <div class="group relative z-10 mx-auto h-64 w-64 shrink-0 overflow-hidden rounded-full border-4 border-surface bg-surface shadow-2xl ring-8 ring-primary/10 transition-shadow duration-300 hover:ring-primary/20 focus-within:ring-primary/20 md:h-80 md:w-80">
            <Image
                src={imageImport.default}
                alt={ME.name}
                loading="eager"
                class="h-full w-full rounded-full object-cover transition-transform duration-500 ease-out group-hover:scale-110 group-focus-within:scale-110"
            />
        </div>
    </div>
</section>
