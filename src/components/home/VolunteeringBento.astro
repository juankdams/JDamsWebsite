---
import SectionHeading from './SectionHeading.astro';

interface Volunteering {
    title: string;
    organization: string;
    period: string;
    description: string;
    icon: string;
    variant: 'featured' | 'wide' | 'compact';
}

interface Props {
    volunteering: Volunteering[];
}

const { volunteering } = Astro.props;

const getCardClass = (variant: Volunteering['variant']) => {
    if (variant === 'featured') {
        return 'md:col-span-2 md:row-span-2 bg-gradient-to-br from-secondary-container/30 to-surface-container-high p-8 md:p-10 justify-between';
    }

    if (variant === 'wide') {
        return 'md:col-span-2 bg-surface-container-low p-8 justify-center';
    }

    return 'md:col-span-1 bg-surface-container-low p-8';
};
---

<section class="relative z-20 mx-auto max-w-container-max px-gutter pb-section-gap" id="voluntariado">
    <SectionHeading
        eyebrow="Voluntariado"
        title="Liderazgo Social Y Humanitario"
        description="Experiencia fuera del entorno corporativo que fortalece disciplina, comunicación y toma de decisiones en campo."
    />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-4 md:gap-6">
        {volunteering.map((item) => (
            <article class:list={[
                'bento-card group relative flex min-h-56 flex-col overflow-hidden rounded-4xl border border-outline-variant/30 transition-colors hover:bg-surface-container-high',
                getCardClass(item.variant),
            ]}>
                {item.variant === 'featured' && (
                    <div class="absolute -right-8 -top-8 h-40 w-40 rounded-full bg-secondary/10 blur-2xl transition-transform duration-700 group-hover:scale-150"></div>
                )}

                <div class="relative z-10">
                    <span class:list={[
                        'material-symbols-outlined mb-5 block text-4xl transition-transform group-hover:-translate-y-1',
                        item.variant === 'featured' ? 'w-fit rounded-2xl bg-surface p-4 text-5xl text-secondary shadow-sm' : 'text-primary',
                    ]}>{item.icon}</span>
                    <h3 class:list={[
                        'mb-2 text-on-surface',
                        item.variant === 'featured' ? 'font-headline-lg text-headline-lg' : 'font-headline-md text-headline-md',
                    ]}>
                        {item.title}
                    </h3>
                    <p class="mb-4 font-label-sm text-label-sm font-bold text-primary">{item.organization}</p>
                    <p class="font-body-md text-body-md text-on-surface-variant">{item.description}</p>
                </div>

                <span class="relative z-10 mt-6 font-label-sm text-label-sm font-bold text-secondary">
                    {item.period}
                </span>
            </article>
        ))}
    </div>
</section>
