---
import { ME } from '@/config';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const prefix = isHome ? '' : '/';
const resume = `/${ME.contactInfo.resumeDoc}`;

const anchorItems = [
  { label: 'Presentación', href: `${prefix}#presentacion` },
  { label: 'Experiencia', href: `${prefix}#experiencia` },
  { label: 'Educación', href: `${prefix}#educacion` },
  { label: 'Stack', href: `${prefix}#technical-stack` },
  { label: 'Hitos', href: `${prefix}#hitos` },
];

const routeItems = [
  { label: 'Proyectos', href: '/projects' },
  { label: 'Artículos', href: '/blog' },
];
---

<nav class="fixed start-0 top-0 z-50 flex w-full items-center justify-center border-b border-outline-variant/20 bg-surface/70 text-on-surface backdrop-blur-xl">
  <div class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-gutter">
    <a href="/" class="group flex items-center gap-2">
      <div class="rounded-2xl bg-primary-container/20 p-2 transition-colors group-hover:bg-primary-container/40">
        <span class="material-symbols-outlined text-primary">terminal</span>
      </div>
      <span class="font-label-md text-label-md font-bold tracking-tighter text-primary">ING_DATOS</span>
    </a>

    <div class="hidden items-center gap-6 rounded-full border border-outline-variant/20 bg-surface-container-low/50 px-8 py-3 md:flex">
      <ul class="flex flex-row items-center gap-6 font-body-md text-body-md">
        {anchorItems.map((item, index) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'font-medium transition-colors hover:text-primary',
                index === 0 && isHome ? 'font-bold text-primary' : 'text-on-surface-variant',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden items-center gap-3 lg:flex">
        {routeItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-label-md text-label-md transition-colors hover:text-primary',
              pathname.startsWith(item.href) ? 'text-primary' : 'text-on-surface-variant',
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
      <a class="hidden rounded-lg bg-primary px-5 py-2.5 font-label-md text-label-md text-on-primary transition hover:bg-primary-container md:inline-flex" href={resume} target="_blank" rel="noopener noreferrer">
        Hoja de vida
      </a>
      <button id="btn-menu" data-collapse-toggle="navbar-sticky" type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg p-2 text-sm text-on-surface-variant transition hover:bg-surface-container-high focus:outline-none focus:ring-2 focus:ring-primary/30 md:hidden"
        aria-controls="navbar-sticky" aria-expanded="false">
        <span class="sr-only">Abrir menú principal</span>
        <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="absolute left-0 top-full hidden w-full border border-t-0 border-outline-variant/20 bg-surface/95 shadow-md backdrop-blur md:hidden" id="navbar-sticky">
    <ul class="flex flex-col items-center gap-4 py-4">
      {[...anchorItems, ...routeItems].map((item) => (
        <li>
          <a
            href={item.href}
            class="px-4 py-2 font-body-md text-body-md text-on-surface-variant transition-colors hover:text-primary"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a class="inline-flex rounded-lg bg-primary px-5 py-2.5 font-label-md text-label-md text-on-primary transition hover:bg-primary-container" href={resume} target="_blank" rel="noopener noreferrer">
          Hoja de vida
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  function toggleNav() {
    const btnMenu = document.getElementById('btn-menu');
    const navbar = document.getElementById('navbar-sticky');
    btnMenu?.addEventListener('click', function () {
      navbar?.classList.toggle('hidden');
    });
    navbar?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => navbar.classList.add('hidden'));
    });
  }
  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>