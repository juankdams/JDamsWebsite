---
import type { ImageMetadata } from 'astro';
import ResumeLayout from '@/layouts/ResumeLayout.astro';
import ResumeDocument from '@/components/resume/ResumeDocument.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { ME } from '@/config';
import { withBase } from '@/lib/utils';

const profile = await getEntry('profile', 'home');

if (!profile) {
    throw new Error('Profile home content was not found.');
}

const { Content } = await render(profile);
const {
    hero,
    skills,
    experience,
    education,
    certifications,
    volunteering,
} = profile.data;

const projectArticles = (await getCollection('projects'))
    .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const projects = projectArticles.map((project) => ({
    title: project.data.title,
    summary: project.data.summary,
    tags: project.data.tags,
    period: `${project.data.startDate.getFullYear()}${project.data.endDate ? ` - ${project.data.endDate.getFullYear()}` : ''}`,
}));

const imagePath = `/src/assets/${ME.profileImage}`;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}');
const profileImage = images[imagePath] ? (await images[imagePath]()).default : undefined;

const homeUrl = withBase('/');
---

<ResumeLayout>
    <div class="resume-toolbar">
        <a class="resume-toolbar-link" href={homeUrl}>← Volver al portafolio</a>
        <button class="resume-toolbar-button" type="button" id="download-resume-pdf">
            Descargar PDF
        </button>
    </div>

    <ResumeDocument
        hero={hero}
        skills={skills}
        experience={experience}
        education={education}
        certifications={certifications}
        volunteering={volunteering}
        projects={projects}
        profileImage={profileImage}
        AboutContent={Content}
    />
</ResumeLayout>

<style>
    .resume-toolbar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 24px;
        background: rgba(249, 249, 255, 0.92);
        border-bottom: 1px solid #dee8ff;
        backdrop-filter: blur(12px);
    }

    .resume-toolbar-link,
    .resume-toolbar-button {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        font-size: 13px;
        font-weight: 600;
    }

    .resume-toolbar-link {
        color: #006948;
        text-decoration: none;
    }

    .resume-toolbar-button {
        border: none;
        border-radius: 10px;
        background: #006948;
        color: #ffffff;
        padding: 10px 18px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .resume-toolbar-button:hover {
        background: #00855d;
    }

    .resume-toolbar-button:disabled {
        opacity: 0.7;
        cursor: wait;
    }
</style>

<script>
    import html2canvas from 'html2canvas';
    import { jsPDF } from 'jspdf';

    const PDF_FILENAME = 'Juan-Camilo-Dams-HdV.pdf';

    async function downloadResumePdf(trigger?: HTMLElement) {
        const pages = Array.from(document.querySelectorAll<HTMLElement>('.resume-page'));
        if (pages.length === 0) return;

        if (trigger) trigger.setAttribute('disabled', 'true');

        try {
            await document.fonts.ready;
            await new Promise((resolve) => window.setTimeout(resolve, 400));

            const pdf = new jsPDF({
                unit: 'mm',
                format: 'letter',
                orientation: 'portrait',
            });

            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();

            for (let index = 0; index < pages.length; index++) {
                const page = pages[index];
                const canvas = await html2canvas(page, {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: '#ffffff',
                    logging: false,
                });

                const imageData = canvas.toDataURL('image/jpeg', 0.98);

                if (index > 0) {
                    pdf.addPage();
                }

                pdf.addImage(imageData, 'JPEG', 0, 0, pageWidth, pageHeight);
            }

            pdf.save(PDF_FILENAME);
        } finally {
            trigger?.removeAttribute('disabled');
        }
    }

    function initResumeDownload() {
        const button = document.getElementById('download-resume-pdf');
        button?.addEventListener('click', () => downloadResumePdf(button));

        if (new URLSearchParams(window.location.search).has('download')) {
            window.setTimeout(() => downloadResumePdf(button ?? undefined), 600);
        }
    }

    initResumeDownload();
    document.addEventListener('astro:after-swap', initResumeDownload);
</script>
