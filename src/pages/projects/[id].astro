
---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BackBtn from "@/components/BackBtn.astro";

export async function getStaticPaths() {
    const posts = await getCollection('projects');
    return posts.map(post => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { title, summary, tags, cover, ogImage } = post.data;

const { Content } = await render(post);

---
<Layout title={title} description={summary} imageOg={ogImage} scrollSmooth={true} fullWidth>
    <div class="mx-auto flex w-full max-w-[1500px] flex-col gap-6 px-4 py-8 sm:px-6 lg:px-10">
        <div class="flex justify-center">
            <BackBtn/>
        </div>

        <header class="grid gap-6 rounded-4xl border border-outline-variant/30 bg-surface-container-low/60 p-6 shadow-sm md:grid-cols-[1.15fr_0.85fr] md:items-center md:p-8 xl:grid-cols-[1.35fr_0.65fr]">
            <div class="flex flex-col gap-4">
                <p class="font-label-md text-label-md font-bold uppercase tracking-[0.18em] text-primary">
                    Caso de proyecto
                </p>
                <h1 class="max-w-4xl text-3xl font-bold text-on-surface md:text-4xl xl:text-5xl">{title}</h1>
                <p class="max-w-4xl font-body-md text-body-md text-on-surface-variant">
                    {summary}
                </p>
                <div class="flex flex-wrap gap-2">
                    {tags.map((tag) => (
                        <span class="rounded-lg bg-surface-container-high px-3 py-1 font-label-sm text-label-sm font-bold text-primary">
                            {tag}
                        </span>
                    ))}
                </div>
            </div>

            <Image transition:name={`${post.id}-image`} class="h-auto max-h-72 w-full rounded-3xl border border-outline-variant/30 bg-white object-contain md:max-h-80" src={cover} alt={`Infografía del proyecto ${title}`}/>
        </header>

        <article id="article" class="project-article prose mt-6 max-w-none">
            <Content/>
        </article>
    </div>
</Layout>

<style is:global>
    .project-article {
        @apply text-sm leading-relaxed;
    }

    .project-article h2 {
        @apply mb-2 mt-6 text-xl font-bold;
    }

    .project-article p {
        @apply my-2;
    }

    .project-article ul {
        @apply my-3 grid gap-1 md:grid-cols-2;
    }

    .project-article li {
        @apply my-0;
    }

    .project-article figure {
        @apply my-6;
    }

    .project-canvas {
        @apply grid gap-5 lg:grid-cols-[0.72fr_1.85fr_0.72fr] lg:items-stretch;
    }

    .project-canvas-panel {
        @apply rounded-3xl border border-outline-variant/30 bg-surface-container-low/70 p-5;
    }

    .project-canvas-flow {
        @apply rounded-3xl border border-outline-variant/30 bg-surface-container-low/70 p-4;
    }

    .project-canvas-kpis {
        @apply grid gap-3 sm:grid-cols-3 lg:grid-cols-1;
    }

    .project-kpi {
        @apply rounded-2xl bg-surface-container-high px-4 py-3;
    }

    .project-kpi strong {
        @apply block text-lg font-bold text-primary;
    }

    .project-kpi span {
        @apply text-xs font-medium text-on-surface-variant;
    }

    .project-flow-card {
        @apply flex min-h-36 flex-col items-center justify-center rounded-3xl border border-outline-variant/40 bg-white px-4 py-5 text-center shadow-sm;
    }

    .project-flow-card span {
        @apply flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary;
    }

    .project-flow-card strong {
        @apply mt-4 block text-base font-bold text-on-surface;
    }

    .project-flow-card p {
        @apply mt-2 text-sm leading-relaxed text-on-surface-variant;
    }

    .project-flow-card em {
        @apply mt-2 text-sm font-bold not-italic text-secondary;
    }
</style>

